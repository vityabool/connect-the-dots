{
  "name": "connect-the-dots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connect the Dots — The Human Network: a team-building game for offsites",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:storage": "azurite --silent --skipApiVersionCheck --location .azurite",
    "dev:api": "npm run build -w api && npm run start -w api",
    "dev:web": "npm run dev -w web",
    "preview:prod": "npm run build && node scripts/serve-dist.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:site": "node scripts/check-site.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "azure-functions-core-tools": "^4.16.0",
    "azurite": "^3.37.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vityabool/connect-the-dots.git"
  },
  "bugs": {
    "url": "https://github.com/vityabool/connect-the-dots/issues"
  },
  "homepage": "https://www.connect-the-dots.top",
  "keywords": [
    "team-building",
    "icebreaker",
    "offsite",
    "workshop",
    "network-graph",
    "azure-static-web-apps",
    "react",
    "typescript"
  ]
}
